# Appwrite Configuration
# Server-side (used in route handlers and scripts)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Client-side (publicly exposed in browser)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# TablesDB Database & Table Identifiers
NEXT_PUBLIC_APPWRITE_DATABASE_ID=splitnest
NEXT_PUBLIC_APPWRITE_TABLE_GROUPS=groups
NEXT_PUBLIC_APPWRITE_TABLE_MEMBERS=members
NEXT_PUBLIC_APPWRITE_TABLE_EXPENSES=expenses
NEXT_PUBLIC_APPWRITE_TABLE_SPLITS=splits
NEXT_PUBLIC_APPWRITE_TABLE_SETTLEMENTS=settlements
